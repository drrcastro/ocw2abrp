# ==============================================================================
# OpenCARWINGS API Configuration (https://opencarwings.viaaq.eu)
# ==============================================================================
# Base URL of the OpenCARWINGS server (default: https://opencarwings.viaaq.eu)
OCW_BASE_URL=https://opencarwings.viaaq.eu

# Option 1 (Recommended): Personal API Key (found in your OpenCARWINGS Account Settings)
OCW_API_KEY=your_opencarwings_api_token_here

# Option 2 (Alternative): Username & Password login (used if OCW_API_KEY is left empty)
OCW_USERNAME=
OCW_PASSWORD=

# Vehicle VIN (optional - if left empty, the script automatically selects the first car on the account)
OCW_VIN=

# Prefer dashboard SoC (soc_display) over raw BMS SoC (soc)
# ABRP documentation recommends using dashboard SoC (true/false)
OCW_USE_DASH_SOC=true

# Nominal energy per GID in Wh (standard Nissan Leaf: 80.0 Wh, or 77.5 Wh)
OCW_GID_WH=80.0

# Send active "Refresh data" command to the car's TCU while driving/charging? (true/false)
# NOTE: Enable only if you do not already use OpenCARWINGS "Periodic Refresh (Running)",
# as waking up the TCU too frequently while parked can drain the 12V battery and use SMS credits.
OCW_ACTIVE_REFRESH=false
# Minimum interval (in seconds) between active TCU refresh requests while driving/charging
OCW_ACTIVE_REFRESH_INTERVAL=300

# ==============================================================================
# ABRP (A Better Routeplanner / Iternio) Configuration
# ==============================================================================
# Vehicle Telemetry User Token from ABRP (required)
# Obtained in ABRP App/Web -> Car Settings -> Live Data -> Generic -> Copy Token
ABRP_USER_TOKEN=your_abrp_user_token_here

# ABRP / Iternio Application API Key
# For v1 (/1/tlm/send), this is the standard public key for generic integrations,
# or you can provide your own key from https://abetterrouteplanner.com/home/app/api-keys/telemetry
ABRP_API_KEY=32b2162f-9599-4647-8139-66e9f9528370

# ABRP Telemetry API version: "v1" (default: /1/tlm/send) or "v2" (/2/app/tlm)
ABRP_API_VERSION=v1

# ==============================================================================
# Script Execution Settings
# ==============================================================================
# OpenCARWINGS polling interval in seconds (default: 30)
POLL_INTERVAL_SECONDS=30

# Maximum time in seconds between ABRP heartbeat updates when car data hasn't changed (default: 300)
HEARTBEAT_SECONDS=300
